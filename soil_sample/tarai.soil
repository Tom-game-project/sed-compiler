pub fn add a:bit32, b:bit32 -> bit32 {
    sed ${
        "s/~\\([^\\~]*\\)~\\([^\\~]*\\)/add 0;;\\1;\\2;/",
        "b addloop",
        ":addloop",
        "s/add 1;\\([01]*\\);;;/1\\1/",
        "s/add 0;\\([01]*\\);;;/\\1/",
        "s/add \\([01]\\);\\([01]*\\);\\([01]*\\);;/add \\1;\\2;\\3;0;/",
        "s/add \\([01]\\);\\([01]*\\);;\\([01]*\\);/add \\1;\\2;0;\\3;/",
        "s/add \\([01]\\);\\([01]*\\);\\([01]*\\)\\([01]\\);\\([01]*\\)\\([01]\\);/add \\1\\4\\6;\\2;\\3;\\5;/",
        "s/add 000;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 0;0\\1;\\2;\\3;/",
        "s/add 001;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 0;1\\1;\\2;\\3;/",
        "s/add 010;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 0;1\\1;\\2;\\3;/",
        "s/add 011;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 1;0\\1;\\2;\\3;/",
        "s/add 100;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 0;1\\1;\\2;\\3;/",
        "s/add 101;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 1;0\\1;\\2;\\3;/",
        "s/add 110;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 1;0\\1;\\2;\\3;/",
        "s/add 111;\\([01]*\\);\\([01]*\\);\\([01]*\\);/add 1;1\\1;\\2;\\3;/",
        "t addloop",
        "s/\\(.*\\)/~\\1;/",
    }$
}

fn zero_padding32 a:bit32 -> bit32 {
    sed${
        "s/~\\([^\\~]*\\)/\\1/",
        "s/^/00000000000000000000000000000000/",
        "s/.*\\(................................\\)$/~\\1;/",
    }$
}

fn twos_complement a:bit32 -> bit32 {
    sed ${
        "s/~\\([^\\~]*\\)/\\1/",
        "y/10/01/",
        "s/\\([01]*\\)/1;\\1;/",
        ":two_complement_loop",
        "s/1;\\([01]*\\)1;\\([01]*\\)/1;\\1;0\\2/",
        "ttwo_complement_loop",
        "s/0;\\([01]*\\)1;\\([01]*\\)/0;\\1;1\\2/",
        "ttwo_complement_loop",
        "s/1;\\([01]*\\)0;\\([01]*\\)/0;\\1;1\\2/",
        "ttwo_complement_loop",
        "s/0;\\([01]*\\)0;\\([01]*\\)/0;\\1;0\\2/",
        "ttwo_complement_loop",
        "s/[01];;\\([01]*\\)/~\\1;/",
    }$
}

fn relation a:bit32, b:bit32 -> char
{
    sed ${
        "s/~\\([01]*\\)~\\([01]*\\)/\\1=\\2/",
        ":compare_loop",
        "s/\\([01]\\)\\([01]*\\)=\\([01]\\)\\([01]*\\)/\\1;\\3;\\2=\\4/",
        "",
        "/^1;1;/ {",
        "    s/^1;1;\\(.\\+\\)/\\1/",
        "    bcompare_loop",
        "}",
        "/^0;0;/ {",
        "    s/^0;0;\\(.\\+\\)/\\1/",
        "    bcompare_loop",
        "}",
        "/^1;0;\\(.*\\)/ {",
        "    s/.*/>/",
        "}",
        "/^0;1;/ {",
        "    s/.*/</",
        "}",
	"s/\\(.*\\)/~\\1;/"
    }$
}

fn gt a:char -> bool {
    sed ${
        "s/^~>$/~1;/",
        "s/^~=$/~0;/",
        "s/^~<$/~0;/",
    }$
}

pub fn sub32 a:bit32, b:bit32 -> bit32 {
    return zero_padding32(add(zero_padding32(a), zero_padding32(twos_complement(b))));
}

pub fn flip_msb a: i32 -> i32 {
    sed ${
        "s/^~1\\([01]*\\)$/~0\\1;/",
        "s/^~0\\([01]*\\)$/~1\\1;/",
    }$
}

pub fn tarai x: i32, y: i32, z: i32 -> i32 {
    if gt(relation(flip_msb(x), flip_msb(y))) {
        return tarai(
            tarai(sub32(x, 1), y, z),
            tarai(sub32(y, 1), z, x),
            tarai(sub32(z, 1), x, y)
        );
    } else {
        return y;
    }
}

// ## compile
//
// ```sh
// cargo run -p soilc -- -i soil_sample/tarai.soil
// ```
//
// ## run
//
// ```sh
// echo ~00000000000000000000000000000110~00000000000000000000000000000011~00000000000000000000000000000000 | sed -f out.sed
// ```
pub fn entry x: i32, y: i32, z: i32 -> i32 {
    return tarai(x, y, z);
}

