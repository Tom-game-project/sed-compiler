fn concat a:str, b:str -> str {
    sed ${
        "s/~\\(.*\\)~\\(.*\\)/~\\1\\2;/",
    }$
}

//```py
//def decimal_to_padding(a: decimal) -> decimal:
//    return a * "p"
//```
fn decimal_to_padding a:decimal -> str {
    sed ${
         "s/~\\([^\\~]*\\)/\\1;9876543210pppppppppp/",
         "s/\\([0-9]\\);.*\\1\\(.*\\)/\\2/",
         "s/..........\\(.*\\)/~\\1;/",
    }$
}

//```py
//def decimal_to_padding_r(a: decimal) -> decimal:
//    return (9 - a) * "p"
//```
fn decimal_to_padding_r a:decimal -> str {
    sed ${
         "s/~\\([^\\~]*\\)/\\1;0123456789pppppppppp/",
         "s/\\([0-9]\\);.*\\1\\(.*\\)/\\2/",
         "s/..........\\(.*\\)/~\\1;/",
    }$
}

//```py
//def lenx9(a: str) -> str:
//    return a * 9
//```
fn lenx9 a:str -> str {
    sed ${
        "s/~\\([^\\~]*\\)/~\\1\\1\\1\\1\\1\\1\\1\\1\\1;/",
    }$
}

//```py
//def decimal_add_one (a: decimal) -> decimal:
//    if a == 8:
//        return 0;
//    else:
//        return a + 1
//```
fn decimal_add_one a: decimal -> decimal {
    sed ${
        "s/~\\([^\\~]*\\)/\\1;0123456780/",
        "s/\\([0-9]\\);.*\\1\\(.\\).*/~\\2;/",
    }$
}

//```py
//def decimal_mod3 (a: decimal) -> decimal:
//    return a%3
//```
fn decimal_mod3 a:decimal -> decimal {
    sed ${
         "s/~\\([^\\~]*\\)/\\1;9876543210:10210210210/",
         "s/^\\([0-9]\\);.*\\1\\(.*\\):/\\2/",
         "s/^..........\\(.\\).*$/~\\1;/",
    }$
}

//```py
//def decimal_div3 (a: decimal) -> decimal:
//    return a//3
//```
fn decimal_div3 a:decimal -> decimal {
    sed ${
         "s/~\\([^\\~]*\\)/\\1;9876543210:33222111000/",
         "s/^\\([0-9]\\);.*\\1\\(.*\\):/\\2/",
         "s/^..........\\(.\\).*$/~\\1;/",
    }$
}

fn load_map81 a:map9x9 -> array9 {
    sed ${
        "s/~\\([^\\~]*\\)/\\1/",
        "s/.................................................................................\\(.........\\).*/~\\1;/",
    }$
}

// "\\(.........\\).*"
// fn get_row map: map9x9, y: decimal -> array9 {
//     sed ${
//         "s/~\\([^\\~]*\\)~\\([^\\~]*\\)/\\1\\2/",
//     }$
// }

fn get_column_helper map: map9x9 -> array9 {
    sed ${
        "s/~.........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\)........\\(.\\).*/~\\1\\2\\3\\4\\5\\6\\7\\8\\9;/",
    }$
}

fn get_column map: map9x9, x: decimal -> array9 {
    return get_column_helper(concat(decimal_to_padding_r(x), map));
    // return concat(decimal_to_padding_r(x), map);
}

